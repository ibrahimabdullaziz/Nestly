datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HOST
  GUEST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  firstName String
  lastName String
  role Role @default(GUEST)
  isVerified Boolean @default(false)
  createAt DateTime @default(now())
  updatedAt DateTime @default(now())
  units Unit[]
  bookings Booking[]
  reviews UnitReview[]
  favorites UnitFavorite[]
}

model Country {
  id String @id @default(uuid())
  name String @unique
  code String @unique
  cities City[]
}

model Currency {
  id String @id @default(uuid())
  code String @unique
  symbol String
  units Unit[]
}

model City {
  id String @id @default(uuid())
  name String
  countryId String
  country Country @relation(fields: [countryId] ,references: [id])
  units Unit[]
  @@unique([name,countryId])
}

model UnitCategory {
  id String @id @default(uuid())
  name String @unique
  units Unit[]
}

model Unit {
   id String @id @default(uuid())
   title String
   description String
   pricePerNight Int
   maxGuests Int
   isActive Boolean @default(false)
   deletedAt DateTime?
   ownerId String
   owner User @relation(fields: [ownerId],references: [id])
   cityId String
   city City @relation(fields: [cityId],references: [id])
   currencyId String
   currency Currency @relation(fields: [currencyId],references: [id])
   categoryId String
   category UnitCategory @relation(fields:[categoryId],references: [id])
   photos       UnitPhoto[]
  bookings     Booking[]
  reviews      UnitReview[]
  favorites    UnitFavorite[]
  createdAt    DateTime     @default(now())

  @@index([cityId,isActive])
  @@index([ownerId])
}

model UnitPhoto{
    id String @id @default(uuid())
    unitId String
    unit Unit @relation(fields: [unitId],references: [id])
    url String
    publicId String
    createdAt DateTime @default(now())
}

model Booking {
  id String @id @default(uuid())
  unitId String
  unit Unit @relation(fields: [unitId],references: [id])
  guestId String
  guest User @relation(fields: [guestId],references: [id])
  checkIn DateTime
  checkOut DateTime
  totalPrice Decimal
  status BookingStatus @default(PENDING)
  createdAt  DateTime @default(now())

  @@index([unitId,checkIn,checkOut])
}

model UnitReview {
  id        String   @id @default(uuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  guestId   String
  guest     User     @relation(fields: [guestId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([unitId, guestId]) // one review per guest per unit
}

model UnitFavorite {
  id     String @id @default(uuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([unitId, userId])
}

model Otp{
    id     String @id @default(uuid())
    email String @unique
    code String
    purpose String
    expiresAt DateTime
    usedAt DateTime?
    CreatedAt DateTime @default(now())

    @@index([email,purpose])
}
